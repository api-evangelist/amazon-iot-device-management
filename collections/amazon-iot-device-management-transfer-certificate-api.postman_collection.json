          "id": "7d70bf3e-c3ae-4dbf-b0c1-a94991b4b676",
          "name": "Amazon IoT Device Management Transfer Certificate",
          "request": {
            "name": "Amazon IoT Device Management Transfer Certificate",
            "description": {
              "content": "<p>Transfers the specified certificate to the specified Amazon Web Services account.</p> <p>Requires permission to access the <a href=\"https://docs.aws.amazon.com/service-authorization/latest/reference/list_awsiot.html#awsiot-actions-as-permissions\">TransferCertificate</a> action.</p> <p>You can cancel the transfer until it is acknowledged by the recipient.</p> <p>No notification is sent to the transfer destination's account. It is up to the caller to notify the transfer target.</p> <p>The certificate being transferred must not be in the ACTIVE state. You can use the <a>UpdateCertificate</a> action to deactivate it.</p> <p>The certificate must not have any policies attached to it. You can use the <a>DetachPolicy</a> action to detach them.</p>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "transfer-certificate",
                "{{certificateId}}"
              ],
              "hash": "targetAwsAccount",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "targetAwsAccount",
                  "value": "<string>",
                  "description": "(Required) The Amazon Web Services account."
                }
              ],
              "variable": [
                {
                  "description": "The AWS region (This can only be one of us-east-1,us-east-2,us-west-1,us-west-2,us-gov-west-1,us-gov-east-1,ca-central-1,eu-north-1,eu-west-1,eu-west-2,eu-west-3,eu-central-1,eu-south-1,af-south-1,ap-northeast-1,ap-northeast-2,ap-northeast-3,ap-southeast-1,ap-southeast-2,ap-east-1,ap-south-1,sa-east-1,me-south-1)",
                  "type": "any",
